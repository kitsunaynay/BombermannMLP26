replays/
# Experiment output is kept: the report's figures and tables are regenerated
# from these metrics, and the failed/intermediate runs are evidence too.
# Model binaries are not kept here; they live in the agent directories.
results/**/*.pt
results/**/*.pkl
results/**/*.npz
# --- AttackOnTensor ---------------------------------------------------------
# Generated by tools/make_report_assets.py from results/; regenerate, don't commit.
report_assets/
# Per-agent framework logs.
agent_code/*/logs/
# Training scratch checkpoints (the tournament artifact stays in the agent dir).
# Both spellings: these are symlinks into /export/scratch since 2026-09-09, and
# a trailing slash matches only real directories, not a symlink to one.
checkpoints/
checkpoints
# Working notes and the course PDF: kept locally, not published.
docs/
TASK.md
final_project.pdf

# W&B run cache; metrics of record live in results/.
wandb/
wandb

# Local assistant/editor state.
.claude/
CLAUDE.md
.aider*
.cursor/
.mcp.json

# Local envs.
.venv/
env/
venv/

# Pristine upstream checkout used by tools/tournament_sim.py (cloned on demand).
.tournament/
